
{% comment %}
  Grumble's Pet Goods - Splash & Storefront Landing Section
{% endcomment %}

<div class="gg" id="grumbles-{{ section.id }}">
  {%- if section.settings.notice_text != blank -%}
    <div class="notice">
      {%- if section.settings.notice_link != blank -%}
        <a href="{{ section.settings.notice_link }}">{{ section.settings.notice_text }}</a>
      {%- else -%}
        {{ section.settings.notice_text }}
      {%- endif -%}
    </div>
  {%- endif -%}

  <nav class="nav" aria-label="Grumble’s navigation">
    <a class="brand" href="{{ routes.root_url }}">
      {{ section.settings.brand_name | default: "Grumble’s" }}
      <span>{{ section.settings.brand_subtitle | default: "PET GOODS · GUS GRUMBLE, PROPRIETOR" }}</span>
    </a>
    <div class="links">
      <a href="#aisles-{{ section.id }}">The good stuff</a>
      <a href="#meet-gus-{{ section.id }}">Meet Gus</a>
      <a class="nav-shop" href="{{ section.settings.shop_link | default: routes.all_products_collection_url }}">
        {{ section.settings.shop_nav_text | default: "Shop the goods" }}
      </a>
      <a class="cart-link" href="{{ routes.cart_url }}" aria-label="Shopping Cart">
        <span>Cart</span>
        <span class="cart-badge">{{ cart.item_count }}</span>
      </a>
    </div>
  </nav>

  <section class="hero" aria-labelledby="gus-title-{{ section.id }}">
    <div class="intro">
      {%- if section.settings.hero_eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.hero_eyebrow }}</span>
      {%- endif -%}
      <h1 id="gus-title-{{ section.id }}">
        {{ section.settings.hero_heading | default: "Good dogs.<br>Questionable<br><em>humans.</em>" }}
      </h1>
      <p>
        {{ section.settings.hero_subtext | default: "Everyday dog goods from Gus Grumble.<br>He has opinions. You’re getting them anyway." }}
      </p>
      <div class="actions">
        <a class="button" href="{{ section.settings.shop_link | default: routes.all_products_collection_url }}">
          {{ section.settings.hero_button_label | default: "Shop dog goods" }}
        </a>
        <a class="text-link" href="#meet-gus-{{ section.id }}">
          {{ section.settings.hero_secondary_link_label | default: "Meet the proprietor" }}
        </a>
      </div>
      {%- if section.settings.hero_scribble != blank -%}
        <p class="scribble">{{ section.settings.hero_scribble }}</p>
      {%- endif -%}
    </div>
    <div class="portrait">
      <img
        src="{% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 1600 }}{% else %}{{ 'gus-hero.jpg' | asset_url }}{% endif %}"
        alt="{{ section.settings.hero_image.alt | default: 'Gus Grumble, a scruffy Brussels griffon in a plaid shirt and apron, opening his warm wooden pet shop.' | escape }}"
        width="1122"
        height="1402"
        fetchpriority="high"
      >
      <div class="stamp">
        <small>{{ section.settings.stamp_top | default: "THE PROPRIETOR" }}</small>
        {{ section.settings.stamp_title | default: "Gus<br>Grumble" }}
        <small>{{ section.settings.stamp_bottom | default: "RELUCTANTLY ONLINE" }}</small>
      </div>
      <div class="nameplate">
        <strong>{{ section.settings.nameplate_heading | default: "A little rough around the ruff." }}</strong>
        <span>{{ section.settings.nameplate_subtext | default: "YOUR NEIGHBORHOOD GRUMP. YOUR DOG’S NEW FRIEND." }}</span>
      </div>
    </div>
  </section>

  {%- if section.settings.ticker_text_1 != blank -%}
    <div class="ticker">
      <span>{{ section.settings.ticker_text_1 }}</span>
      {%- if section.settings.ticker_text_2 != blank -%}
        <b>✦</b><span>{{ section.settings.ticker_text_2 }}</span>
      {%- endif -%}
      {%- if section.settings.ticker_text_3 != blank -%}
        <b>✦</b><span>{{ section.settings.ticker_text_3 }}</span>
      {%- endif -%}
    </div>
  {%- endif -%}

  <!-- Dynamic Aisles Section -->
  <section class="aisles" id="aisles-{{ section.id }}">
    <div class="section-top">
      <div>
        <span class="eyebrow">{{ section.settings.aisles_eyebrow | default: "A few of life’s necessities" }}</span>
        <h2>{{ section.settings.aisles_heading | default: "Dogs have priorities." }}</h2>
      </div>
      <p>{{ section.settings.aisles_subtext | default: "Walk. Play. Eat. Make a mess.<br>Gus understands the assignment." }}</p>
    </div>

    <div class="grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'aisle' -%}
          {%- if block.settings.url != blank -%}
            <a href="{{ block.settings.url }}" class="aisle" {{ block.shopify_attributes }}>
          {%- else -%}
            <div class="aisle" {{ block.shopify_attributes }}>
          {%- endif -%}
              <div>
                <span class="number">{{ block.settings.number }}</span>
                <h3>{{ block.settings.title }}</h3>
              </div>
              <p>{{ block.settings.quote }}</p>
          {%- if block.settings.url != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  <!-- Featured Collection / Product Grid -->
  {%- if section.settings.featured_collection != blank and section.settings.featured_collection.products_count > 0 -%}
    {%- assign collection = section.settings.featured_collection -%}
    <section class="featured-products">
      <div class="section-top">
        <div>
          <span class="eyebrow">{{ section.settings.products_eyebrow | default: "Approved by Gus (reluctantly)" }}</span>
          <h2>{{ section.settings.products_heading | default: "Goods on the shelves." }}</h2>
        </div>
        <p>{{ section.settings.products_subtext | default: "Tested against enthusiastic teeth and stubborn muddy paws." }}</p>
      </div>

      <div class="products-grid">
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          <article class="product-card">
            <div class="product-image-wrapper">
              <a href="{{ product.url }}">
                {%- if product.featured_image != blank -%}
                  <img
                    src="{{ product.featured_image | image_url: width: 600 }}"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag }}
                {%- endif -%}
              </a>
            </div>
            <div>
              <h3 class="product-title">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>
              <div class="product-price">
                {{ product.price | money }}
                {%- if product.compare_at_price > product.price -%}
                  <s>{{ product.compare_at_price | money }}</s>
                {%- endif -%}
              </div>
            </div>
            {%- if product.available -%}
              <form method="post" action="{{ routes.cart_add_url }}">
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button type="submit" class="button product-btn">Add to cart</button>
              </form>
            {%- else -%}
              <button class="button product-btn" disabled style="opacity: 0.6; cursor: not-allowed;">Sold out</button>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  <!-- Story Section -->
  <section class="story" id="meet-gus-{{ section.id }}">
    <img
      src="{% if section.settings.story_image != blank %}{{ section.settings.story_image | image_url: width: 1200 }}{% else %}{{ 'gus-counter.jpg' | asset_url }}{% endif %}"
      alt="{{ section.settings.story_image.alt | default: 'Gus at his shop counter giving a skeptical look beside a thoroughly destroyed stuffed duck.' | escape }}"
      width="1122"
      height="1402"
      loading="lazy"
    >
    <div class="story-copy">
      <span class="eyebrow">{{ section.settings.story_eyebrow | default: "Meet the management" }}</span>
      <h2>{{ section.settings.story_heading | default: "A small shop.<br>A considerable<br>number of opinions." }}</h2>
      <p>{{ section.settings.story_p1 | default: "Gus believes dogs deserve useful things, humans deserve clear explanations, and nobody needs to “reimagine the fetch experience.”" }}</p>
      <p>{{ section.settings.story_p2 | default: "He remembers your dog’s name. Yours? He’s working on it." }}</p>
      <p>{{ section.settings.story_p3 | default: "He’ll grumble when you arrive just after closing. Then he’ll unlock the door." }}</p>
      <div class="signature">{{ section.settings.story_signature | default: "— Gus Grumble" }}</div>
      <span class="eyebrow" style="margin-top:14px">{{ section.settings.story_signoff | default: "Proprietor. People person, allegedly." }}</span>
    </div>
  </section>

  <!-- Notes & FAQs Section -->
  <section class="notes">
    <span class="eyebrow">{{ section.settings.notes_eyebrow | default: "Notes from behind the counter" }}</span>
    <h2>{{ section.settings.notes_heading | default: "Since you’re here." }}</h2>

    {%- for block in section.blocks -%}
      {%- if block.type == 'faq_item' -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <p>{{ block.settings.answer }}</p>
        </details>
      {%- endif -%}
    {%- endfor -%}
  </section>

  <!-- Newsletter Signup Section -->
  <section class="newsletter-section">
    <div class="newsletter-inner">
      <span class="eyebrow">{{ section.settings.newsletter_eyebrow | default: "Unenthusiastic Correspondence" }}</span>
      <h2>{{ section.settings.newsletter_heading | default: "Gus might send an email." }}</h2>
      <p>{{ section.settings.newsletter_subtext | default: "New arrivals, store announcements, and zero inspirational dog quotes. We respect your inbox." }}</p>

      {% form 'customer', class: 'newsletter-form-wrapper' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <div class="form-status form-status--success" tabindex="-1" autofocus>
            {{ section.settings.newsletter_success | default: "You’re in. Gus is already regretting having a mailing list." }}
          </div>
        {%- else -%}
          <div class="newsletter-form">
            <input
              id="NewsletterEmail--{{ section.id }}"
              type="email"
              name="contact[email]"
              class="newsletter-input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder="Your email address"
              required
            >
            <button type="submit" class="button newsletter-btn">
              {{ section.settings.newsletter_button_text | default: "Sign up (reluctantly)" }}
            </button>
          </div>
          {%- if form.errors -%}
            <div class="form-status form-status--error">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </div>
          {%- endif -%}
        {%- endif -%}
      {% endform %}
    </div>
  </section>

  <!-- Final CTA Section -->
  <section class="final">
    <div>
      <span class="eyebrow">{{ section.settings.cta_eyebrow | default: "That tail isn’t going to wag itself." }}</span>
      <h2>{{ section.settings.cta_heading | default: "Something for your good dog." }}</h2>
      <p>{{ section.settings.cta_subtext | default: "Gus will pretend he’s not pleased you stopped by." }}</p>
    </div>
    <a class="button" href="{{ section.settings.shop_link | default: routes.all_products_collection_url }}">
      {{ section.settings.cta_button_text | default: "Take a look around" }}
    </a>
  </section>

  <footer>
    <span>{{ section.settings.footer_left | default: "Grumble’s Pet Goods · Good stuff. Grumpy service." }}</span>
    <span>{{ section.settings.footer_right | default: "Fictional proprietor. Very real dog people." }}</span>
  </footer>
</div>

